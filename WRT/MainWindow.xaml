<Window x:Class="WRT.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WRT"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="450" ResizeMode="NoResize">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="40*"/>
            <RowDefinition Height="177*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Column="0" Grid.Row="0" HorizontalAlignment="Right" Margin="0, 0, 10, 0">
            <TextBlock Text="Zapret version"/>
            <TextBlock Text="TG WS Proxy"/>
            <TextBlock Text="Домены в hosts"/>
            <TextBlock Text="Стратегия zapret"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Grid.Row="0" Margin="10, 0, 0, 0">
            <TextBlock Text="${version}"/>
            <TextBlock Text="${Proxy}"/>
            <TextBlock Text="${hosts}"/>
            <TextBlock Text="${Стратегия}"/>
        </StackPanel>
        <ScrollViewer Grid.Column="1" Grid.Row="1">
            <StackPanel Margin="0,10,0,10">
                <Button Width="150" Height="40" Margin="0,0,0,5"/>
                <Button Width="150" Height="40" Margin="0,0,0,5"/>
                <Button Width="150" Height="40" Margin="0,0,0,5"/>
                <Button Width="150" Height="40" Margin="0,0,0,5"/>
                <Button Width="150" Height="40" Margin="0,0,0,5"/>
                <Button Width="150" Height="40" Margin="0,0,0,5"/>
                <Button Width="150" Height="40" Margin="0,0,0,5"/>
                <Button Width="150" Height="40" Margin="0,0,0,5"/>
                <Button Width="150" Height="40" Margin="0,0,0,5"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>

</Window>
